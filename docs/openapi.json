  "components": {
    "securitySchemes": {
      "userBearer": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "Supabase user JWT"
      }
    },
    "schemas": {
      "CompanyInput": {
        "type": "object",
        "additionalProperties": false,
        "minProperties": 1,
        "properties": {
          "business_name": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 300
          },
          "theme": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 300
          },
          "presentation_date": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 300
          },
          "status": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 300
          },
          "cooperation_level": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 300
          },
          "report_status": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 300
          },
          "intake_date": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 300
          },
          "reapplicant": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 300
          },
          "business_summary": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 4000
          },
          "program_year": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 2000,
            "maximum": 2200
          },
          "assigned_consultant_id": {
            "type": [
              "string",
              "null"
            ],
            "format": "uuid"
          },
          "ir_direct": {
            "type": "boolean"
          }
        }
      },
      "ProfileInput": {
        "type": "object",
        "additionalProperties": false,
        "minProperties": 1,
        "properties": {
          "display_name": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 100
          },
          "role": {
            "enum": [
              "host",
              "admin",
              "user"
            ]
          },
          "user_kind": {
            "enum": [
              "consultant",
              "client"
            ]
          },
          "company_id": {
            "type": [
              "string",
              "null"
            ],
            "format": "uuid"
          },
          "approved": {
            "type": "boolean"
          },
          "active": {
            "type": "boolean"
          }
        }
      },
      "SessionInput": {
        "type": "object",
        "additionalProperties": false,
        "minProperties": 1,
        "properties": {
          "kind": {
            "enum": [
              "diagnosis",
              "consulting"
            ]
          },
          "round_number": {
            "type": "integer",
            "minimum": 1,
            "maximum": 3
          },
          "scheduled_on": {
            "type": [
              "string",
              "null"
            ],
            "format": "date"
          },
          "remote": {
            "type": "boolean"
          },
