# APFS 전용 공개 Supabase URL. 기존 별도 APFS 프로젝트를 사용합니다.
NEXT_PUBLIC_SUPABASE_URL=
# 클라이언트 publishable key만 사용합니다. service role / DB 비밀번호 금지.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# 현재 코드의 APFS 공개 연결값 fallback은 유지했습니다.
# Google OAuth Client ID/Secret은 승인된 Supabase Auth console에만 설정합니다.

# Google OAuth 공급자와 Redirect URL을 외부 콘솔에서 설정한 후에만 true로 지정
NEXT_PUBLIC_GOOGLE_AUTH_ENABLED=false

# --- 서버 전용 메일 설정 (NEXT_PUBLIC_ 금지, 비밀값은 Vercel 환경변수에만) ---
# RESEND_API_KEY는 여기에 적지 말고 Vercel Production 환경변수로만 설정합니다.
# 발신 주소: Resend에서 인증한 도메인 사용
P1_EMAIL_FROM=
# 수신자가 회신할 주소(Resend reply_to). 비워 두면 기본값 sasurae@intw.co.kr 사용
P1_EMAIL_REPLY_TO=sasurae@intw.co.kr
